rules_version = '2';

// NOT DEPLOYED YET. Deploy after the user Cloud Functions are live and tested.
// Only signed-in staff (people with a document in /users) can read or write data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Users can be read by staff, but only changed by the Cloud Functions
    // (createUser, updateUser, deleteUser), which check permissions first.
    // Cloud Functions use admin rights, so these rules don't block them.
    match /users/{uid} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /{collection}/{docId} {
      allow read, write: if isStaff()
        && collection in ['clients', 'client-jobs', 'contacts', 'items', 'jobs', 'services'];
    }
  }
}
